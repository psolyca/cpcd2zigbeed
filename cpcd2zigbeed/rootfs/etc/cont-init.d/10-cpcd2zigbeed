#!/usr/bin/env bashio
set -euo pipefail

RCP_HOST="$(bashio::config 'rcp_host')"
RCP_PORT="$(bashio::config 'rcp_port')"
CPCD_INSTANCE="$(bashio::config 'cpcd_instance')"
CPC_BROADCAST_IID="$(bashio::config 'cpc_broadcast_iid')"

export RCP_HOST RCP_PORT CPCD_INSTANCE CPC_BROADCAST_IID

bashio::log.info "Configuring CPCd2Zigbeed"
bashio::log.info "RCP endpoint: ${RCP_HOST}:${RCP_PORT}"
bashio::log.info "CPCd instance: ${CPCD_INSTANCE}"

mkdir -p \
  "/dev/shm/cpcd/${CPCD_INSTANCE}" \
  /etc/cpcd \
  /var/lib/zigbeed \
  /var/log/cpcd

cat > /etc/cpcd/cpcd.conf <<EOF_CONF
# Generated by the Home Assistant app at startup.
instance_name: ${CPCD_INSTANCE}
bus_type: TCP
tcp_server_address: ${RCP_HOST}
tcp_server_port: ${RCP_PORT}
disable_encryption: true
stdout_trace: false
trace_to_file: false
traces_folder: /var/log/cpcd
EOF_CONF

bashio::log.info "Generated /etc/cpcd/cpcd.conf"
